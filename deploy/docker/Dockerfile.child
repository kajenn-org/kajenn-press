# site server: published sites from the release bucket; no Gramlot or render worker installed.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

COPY deploy/docker/requirements-child.txt /tmp/
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-child.txt

COPY pyproject.toml README.md /src/
COPY src /src/src
RUN pip install --no-cache-dir --no-deps /src && pip check

COPY deploy/docker/site_server.py /app/site_server.py

RUN useradd --uid 10003 --create-home app && mkdir -p /cache && chown app:app /cache
USER app
WORKDIR /app
EXPOSE 8877
CMD ["python", "/app/site_server.py"]
