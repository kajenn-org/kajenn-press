# websites: administration, internal installation and a separate render worker environment.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

COPY deploy/docker/requirements-websites.txt deploy/docker/requirements-render.txt /tmp/
RUN python -m venv /opt/render \
    && /opt/render/bin/pip install --no-cache-dir --require-hashes -r /tmp/requirements-render.txt \
    && pip install --no-cache-dir --require-hashes -r /tmp/requirements-websites.txt

COPY pyproject.toml README.md /src/
COPY src /src/src
RUN pip install --no-cache-dir --no-deps /src \
    && /opt/render/bin/pip install --no-cache-dir --no-deps /src \
    && pip check && /opt/render/bin/pip check

COPY deploy/docker/websites.py /app/websites.py
COPY examples/kajenn_org /app/kajenn_org

RUN useradd --uid 10002 --create-home app && mkdir -p /data /config && chown app:app /data /config
USER app
WORKDIR /app
EXPOSE 8875
CMD ["python", "/app/websites.py"]
