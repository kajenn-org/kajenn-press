# Copy to deploy/docker/.env. These values are for the Mac, without a reverse proxy.
# Browsers resolve *.localhost to this machine.

# http on the Mac; https on a server behind a TLS reverse proxy.
KPRESS_SCHEME=http
# Administration origin and private preview origin; they must differ.
KPRESS_MANAGEMENT_HOST=kpress.localhost:8875
KPRESS_PREVIEW_HOST=preview.kpress.localhost:8875
# Addresses (or CIDR networks) whose X-Forwarded-Proto/For headers websites trusts.
# On the Mac no proxy sends them; on a server, the address the reverse proxy connects from.
KPRESS_TRUSTED_PROXIES=127.0.0.1
